# quiz-service — copy to .env and fill in. Never commit .env.
PORT=4005
DB_URL=mongodb://USER:PASSWORD@HOST:27017/DBNAME?authSource=admin
JWT_SECRET=same-value-as-auth-service
ALLOWED_ORIGINS=http://localhost:5173

QUESTION_SERVICE_URL=http://localhost:4003
TOPIC_SERVICE_URL=http://localhost:4002
POST_SERVICE_URL=http://localhost:4004
AUTH_SERVICE_URL=http://localhost:4001

# Daily quiz limits come from billing-service. Both must be set for limits to be enforced
# (when either is empty, limits are OFF and a warning is logged). Use the SAME secret as billing-service.
BILLING_SERVICE_URL=http://localhost:4008
INTERNAL_SERVICE_SECRET=

# DigitalOcean Spaces (quiz cover images)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://REGION.digitaloceanspaces.com
DO_SPACES_BUCKET=
DO_SPACES_CDN_URL=https://BUCKET.REGION.cdn.digitaloceanspaces.com

# Firebase Admin (push notifications; optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
