# billing-service — copy to .env and fill in. Never commit .env.
PORT=4008
NODE_ENV=production

# Same MongoDB and JWT secret as the other services
DB_URL=mongodb://USER:PASSWORD@HOST:27017/DBNAME?authSource=admin
JWT_SECRET=same-value-as-auth-service

# Browser origins allowed to call /api/billing (docker-compose.prod.yml sets this for production)
ALLOWED_ORIGINS=http://localhost:5173

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks).
# Leave empty to keep checkout disabled; the Plans page then shows "payments not set up yet".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shared secret for service-to-service calls (/internal/*). Use a long random value and set the
# SAME value in quiz-service and post-service. Internal API is disabled while this is empty.
INTERNAL_SERVICE_SECRET=

# Creator earnings (₹0.10 per eligible view is fixed in code)
# Same viewer + same post counts once per this many hours
VIEW_DEDUPE_HOURS=24
# Earnings clear (become approved/withdrawable) this many days after the day of the view
EARNINGS_HOLD_DAYS=7
# More anonymous views than this from one network on one post per day are not paid
VIEW_MAX_ANON_PER_IP_POST_DAY=30

# Payout details (bank / UPI / gift-card email) are encrypted with this key (AES-256-GCM).
# 32 random bytes, base64 or hex — e.g. `openssl rand -base64 32`. Withdrawals are disabled while empty.
# Keep a safe backup: without it saved payout details cannot be read.
PAYOUT_ENCRYPTION_KEY=
# During a key rotation, the old key goes here so existing details can still be read
PAYOUT_ENCRYPTION_KEY_PREVIOUS=
