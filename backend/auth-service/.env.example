# auth-service — copy to .env and fill in. Never commit .env.
PORT=4001
NODE_ENV=production
DB_URL=mongodb://USER:PASSWORD@HOST:27017/DBNAME?authSource=admin
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
FRONTEND_URL=http://localhost:5173
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Mail (Hostinger SMTP) — also used for premium-post review emails
MAIL_USER=
MAIL_PASSWORD=

# Service-to-service secret for /internal/* (review emails). SAME value as billing-, quiz-,
# post-service and agentic/post-creator. Internal API is disabled while empty.
INTERNAL_SERVICE_SECRET=

# DigitalOcean Spaces (avatars, uploads)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://REGION.digitaloceanspaces.com
DO_SPACES_BUCKET=
DO_SPACES_CDN_URL=https://BUCKET.REGION.cdn.digitaloceanspaces.com

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
