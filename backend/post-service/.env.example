# post-service — copy to .env and fill in. Never commit .env.
PORT=4004
NODE_ENV=production
DB_URL=mongodb://USER:PASSWORD@HOST:27017/DBNAME?authSource=admin
JWT_SECRET=same-value-as-auth-service
ALLOWED_ORIGINS=http://localhost:5173
SITE_URL=https://meenzo.com
POST_FILTER_URL=http://localhost:5100

# Service-to-service secret. Must be the SAME value in billing-service, quiz-service, post-service
# and agentic/post-creator (AI posts are created with it). Use a long random value.
INTERNAL_SERVICE_SECRET=
# Creator plans / premium posts. Premium post features are refused while this is empty.
BILLING_SERVICE_URL=http://localhost:4008

# DigitalOcean Spaces — premium post images (uploads and accepted AI images)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://REGION.digitaloceanspaces.com
DO_SPACES_BUCKET=
DO_SPACES_CDN_URL=https://BUCKET.REGION.cdn.digitaloceanspaces.com

# OpenAI — post moderation and (optional) AI cover images for premium posts
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODELS=gpt-image-1
# AI cover images stay off unless this is exactly "true" (and the key + Spaces are set)
AI_IMAGE_ENABLED=false
AI_IMAGE_DAILY_LIMIT=5

# Premium post review
# Automatic LLM screening before human review (advice only). Set to false to switch it off.
PREMIUM_SCREENING_ENABLED=true
OPENAI_VALIDATION_MODEL=gpt-4o-mini
OPENAI_VALIDATION_TIMEOUT_MS=20000
# Emailed when a post is submitted and no reviewer or admin account exists yet (optional)
PREMIUM_REVIEW_EMAIL_FALLBACK=
# Review emails are sent through auth-service's mailer (/internal/email)
AUTH_SERVICE_URL=http://localhost:4001

# Premium view counting. Views are counted only while this is set (long random value).
VIEW_TOKEN_SECRET=
# A view counts only after the post has been open this many seconds
VIEW_MIN_DWELL_SECONDS=5
# Proxies in front of this service (production: host nginx + frontend nginx = 2)
TRUST_PROXY_HOPS=2

# Firebase Admin (push notifications; optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
